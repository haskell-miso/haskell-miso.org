-- Local development project file: builds against the sibling ../miso checkout.
-- Use:  cabal --project-file=cabal.project.dev build
packages:
  .

allow-newer:
  all:base

if arch(wasm32)
  shared: True

source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  tag: cba08d9

if !arch(wasm32) && !arch(javascript)
  package miso
    flags: +ssr
