-- Local development project file: builds against the sibling ../miso checkout.
-- Use:  cabal --project-file=cabal.project.dev build
packages:
  .

allow-newer:
  all:base

if arch(wasm32)
  shared: True

-- Miso.FFI.QQ (the js quasi-quoter) lives behind miso's template-haskell flag
package miso
  flags: +template-haskell

source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  tag: cba08d9

if !arch(wasm32) && !arch(javascript)
  package miso
    flags: +ssr
