-- haskell-miso.org
--
-- The only dependency is miso itself, taken from the sibling ../miso
-- checkout. Enter a toolchain with `nix develop .#wasm` (WASM),
-- `nix develop .#ghcjs` (JavaScript backend) or `nix develop` (vanilla GHC,
-- for the prerenderer).
--
-- NOTE: the site needs misoWithContext / prerenderWithContext plus the
-- rAFSub cancelAnimationFrame fix, both merged to master.
packages:
  .

allow-newer:
  all:base

source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  tag: 1.14.0

if arch(wasm32)
  shared: True

-- Miso.FFI.QQ (the js quasi-quoter) lives behind miso's template-haskell flag
package miso
  flags: +template-haskell

-- The prerenderer (vanilla GHC) needs miso's server-side rendering flag so
-- that `text` HTML-encodes and `hydrateModel` is honoured.
if !arch(wasm32) && !arch(javascript)
  package miso
    flags: +ssr
