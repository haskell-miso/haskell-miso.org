-- haskell-miso.org
--
-- The only dependency is miso itself, pulled straight from GitHub. Enter a
-- toolchain with `nix develop .#wasm` (WASM), `nix develop .#ghcjs`
-- (JavaScript backend) or `nix develop` (vanilla GHC, for the prerenderer).
--
-- NOTE: the site needs misoWithContext / prerenderWithContext (merged to
-- master) plus the rAFSub cancelAnimationFrame fix (asyncCallback-canvas
-- branch). Once that branch is merged, bump the tag below to the merge
-- commit. For local development against a sibling ../miso checkout
-- use:  make PROJECT=cabal.project.dev
packages:
  .

allow-newer:
  all:base

source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  -- the asyncCallback-canvas branch (rAFSub: cancel pending frame on unmount)
  tag: eca814d0aca45de5c4b616dc8c6b2e57718f49ec

if arch(wasm32)
  shared: True

-- The prerenderer (vanilla GHC) needs miso's server-side rendering flag so
-- that `text` HTML-encodes and `hydrateModel` is honoured.
if !arch(wasm32) && !arch(javascript)
  package miso
    flags: +ssr
